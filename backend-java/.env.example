# ATS Backend — Java 21 / Spring Boot 3 Environment
# Copy to .env and fill in real values

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/ats_db
DATABASE_USER=ats_user
DATABASE_PASSWORD=ats_password

# JWT — generate a strong 256-bit base64 secret in production
JWT_SECRET=your-very-long-secret-key-at-least-256-bits-for-hs256-algorithm-change-me-in-production
JWT_EXPIRATION_MS=86400000

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# File Storage
UPLOAD_DIR=./uploads

# Mail (optional — for IMAP email ingestion)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Tesseract OCR data path (for scanned PDF fallback)
# Download eng.traineddata from https://github.com/tesseract-ocr/tessdata
TESSERACT_DATAPATH=./tessdata

# Server Port
PORT=8080
