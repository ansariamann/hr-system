# ─── ATS System — Required Environment Variables ──────────────────────────────
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit .env with real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=ats_db
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be a cryptographically random string of at least 64 characters.
# Generate one with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_64
JWT_EXPIRATION_MS=3600000

# ── First-run bootstrap ───────────────────────────────────────────────────────
# Set these ONLY on first startup to create the initial super_admin account.
# Remove/unset them immediately after the account is created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────
# IMAP email ingestion (disabled by default)
IMAP_INGESTION_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# JobRunr dashboard — only enable locally, never in production
JOBRUNR_DASHBOARD_ENABLED=false
